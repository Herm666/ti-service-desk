# --- Banco de dados (PostgreSQL gerenciado — Vercel Postgres/Neon) ---
# URL de conexão "pooled", usada pela aplicação em runtime.
DATABASE_URL="postgresql://usuario:senha@host-pooler.regiao.aws.neon.tech/ti_service_desk?sslmode=require"
# URL de conexão direta (sem pooling), usada pelo Prisma em migrations/build.
DATABASE_URL_UNPOOLED="postgresql://usuario:senha@host.regiao.aws.neon.tech/ti_service_desk?sslmode=require"

# --- Autenticação ---
JWT_SECRET="troque-por-uma-chave-grande-e-aleatoria"

# --- Domínio da aplicação (usado em links, e-mails etc.) ---
APP_URL="https://ti.suaescola.com.br"

# --- Storage de anexos (Vercel Blob) ---
# Gerado automaticamente ao criar/conectar um Blob Store ao projeto na Vercel.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxxxxxxxxxx"
